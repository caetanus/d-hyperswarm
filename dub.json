{
	"name": "hyperswarm",
	"description": "Holepunch hyperswarm in D — wire-compatible with the real network, fibers on vibe-core, crypto on libsodium",
	"authors": [
		"caetano"
	],
	"license": "MIT",
	"targetType": "library",
	"targetPath": "bin",
	"sourcePaths": [
		"source"
	],
	"importPaths": [
		"source"
	],
	"dependencies": {
		"vibe-core": "~>2.0",
		"libsodiumd": "~>0.2"
	},
	"preBuildCommands": [
		"bash $PACKAGE_DIR/vendor/build-libudx.sh"
	],
	"lflags": [
		"bin/libhsudx.a"
	],
	"libs": [
		"m",
		"sodium"
	],
	"configurations": [
		{
			"name": "library",
			"targetType": "library"
		},
		{
			"name": "udx-interop-peer",
			"targetType": "executable",
			"targetName": "udx-interop-peer",
			"mainSourceFile": "interop/udx-dpeer/app.d",
			"sourcePaths": [
				"source",
				"interop/udx-dpeer"
			],
			"importPaths": [
				"source",
				"interop/udx-dpeer"
			]
		},
		{
			"name": "dht-connect-peer",
			"targetType": "executable",
			"targetName": "dht-connect-peer",
			"mainSourceFile": "interop/dht-connect/app.d",
			"sourcePaths": ["source", "interop/dht-connect"],
			"importPaths": ["source", "interop/dht-connect"]
		},
		{
			"name": "hyperswarm-peer",
			"targetType": "executable",
			"targetName": "hyperswarm-peer",
			"mainSourceFile": "interop/hyperswarm-dpeer/app.d",
			"sourcePaths": ["source", "interop/hyperswarm-dpeer"],
			"importPaths": ["source", "interop/hyperswarm-dpeer"]
		},
		{
			"name": "dht-announce-peer",
			"targetType": "executable",
			"targetName": "dht-announce-peer",
			"mainSourceFile": "interop/dht-announce/app.d",
			"sourcePaths": ["source", "interop/dht-announce"],
			"importPaths": ["source", "interop/dht-announce"]
		},
		{
			"name": "dht-lookup-peer",
			"targetType": "executable",
			"targetName": "dht-lookup-peer",
			"mainSourceFile": "interop/dht-lookup/app.d",
			"sourcePaths": ["source", "interop/dht-lookup"],
			"importPaths": ["source", "interop/dht-lookup"]
		},
		{
			"name": "dht-interop-peer",
			"targetType": "executable",
			"targetName": "dht-interop-peer",
			"mainSourceFile": "interop/dht-dpeer/app.d",
			"sourcePaths": [
				"source",
				"interop/dht-dpeer"
			],
			"importPaths": [
				"source",
				"interop/dht-dpeer"
			]
		},
		{
			"name": "secretstream-interop-peer",
			"targetType": "executable",
			"targetName": "secretstream-interop-peer",
			"mainSourceFile": "interop/ss-dpeer/app.d",
			"sourcePaths": [
				"source",
				"interop/ss-dpeer"
			],
			"importPaths": [
				"source",
				"interop/ss-dpeer"
			]
		},
		{
			"name": "ut",
			"targetType": "executable",
			"targetName": "hyperswarm-test",
			"mainSourceFile": "tests/runner.d",
			"sourcePaths": [
				"source",
				"tests"
			],
			"importPaths": [
				"source",
				"tests"
			],
			"dependencies": {
				"unit-threaded": "~>2.2",
				"fluent-asserts": "~>2.0"
			},
			"dflags": [
				"-unittest"
			]
		}
	]
}
